#!/bin/sh
# Pre-commit checks for Vedic Math. Enable once per clone:
#   git config core.hooksPath .githooks
# Skip in an emergency with: git commit --no-verify
#
# 1. The app builds (build.py into a throwaway directory). This also fails if the source carries
#    cache stamps, which only the CI deploy adds.
# 2. Unit tests.

cd "$(git rev-parse --show-toplevel)" || exit 1

fail() {
  printf '\npre-commit: %s\n' "$1" >&2
  exit 1
}

tmp=$(mktemp -d) || fail "could not make a temp directory"
trap 'rm -rf "$tmp"' EXIT
python3 build.py --out "$tmp/site" >/dev/null || fail "build.py failed (see above)"

# Tests make their own temp git repos; git's hook variables would point those at this repository
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
command -v node >/dev/null 2>&1 || fail "node is required to run test/"
node --test --test-reporter=dot 'test/**/*.test.{js,mjs}' >&2 || fail "tests failed"

exit 0
