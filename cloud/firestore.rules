rules_version = '2';
// Vedic Math for Everyone: leaderboards. Public read; each signed-in (anonymous) player owns one entry per board.
// Only a generated nickname, an avatar color, an integer score and a server timestamp are allowed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{board}/scores/{uid} {
      function validBoard() {
        return board.matches('^(daily-[0-9]{4}-[0-9]{2}-[0-9]{2}|week-[0-9]{4}-W[0-9]{2})-(explorer|challenger|pro)$');
      }
      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'avatar', 'score', 'ts'])
          && d.name is string && d.name.matches('^[A-Z][a-z]+ [A-Z][a-z]+ [0-9]{2}$')
          && d.avatar in ['coral', 'teal', 'sun', 'sky', 'plum']
          && d.score is int && d.score >= 0 && d.score <= 2000
          && d.ts == request.time;
      }
      allow read: if validBoard();
      allow create: if request.auth != null && request.auth.uid == uid && validBoard() && validEntry();
      allow update: if request.auth != null && request.auth.uid == uid && validBoard() && validEntry()
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
