rules_version = '2';
// Vedic Math for Everyone: leaderboards.
// The only writer is the Arena daily round (vedic-math/js/app.js -> cloud.submit), once per round, to two boards:
//   boards/daily-YYYY-MM-DD-<league>/scores/<uid> and boards/week-YYYY-Www-<league>/scores/<uid>.
// Each signed-in (anonymous) player owns one entry per board. Allowed fields, nothing else:
//   name   a generated nickname from the fixed word lists in vedic-math/js/store.js (never typed)
//   avatar one of five colors
//   score  an even integer from 10 to the league cap (see maxScore)
//   ts     the server time of the write
//   exp    when the entry deletes itself (Firestore TTL policy on `exp`), 1 to 60 days ahead
service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/{board}/scores/{uid} {
      function validBoard() {
        return board.matches('^(daily-20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])|week-20[0-9]{2}-W(0[1-9]|[1-4][0-9]|5[0-3]))-(explorer|challenger|pro)$');
      }
      function signedInAs() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Boards are named after the player's local date, so a board is writable only while that date or ISO week
      // is current somewhere on Earth (UTC-12 to UTC+14), plus one hour of slack. Old and future boards are frozen.
      function boardStart() {
        let p = board.split('-');
        return p[0] == 'daily' ? timestamp.date(num(p[1]), num(p[2]), num(p[3])) : weekStart(num(p[1]), num(p[2].replace('W', '')));
      }
      function num(s) { return int(s.replace('^0', '')); } // '08' -> 8
      // Monday 00:00 UTC of ISO week w in year y. Jan 4 is always in week 1; 1970-01-01 was a Thursday,
      // so (millis + 3 days) % 7 days is the time since that week's Monday.
      function weekStart(y, w) {
        let jan4 = timestamp.date(y, 1, 4);
        let sinceMonday = (jan4.toMillis() + 259200000) % 604800000;
        return jan4 - duration.value(sinceMonday, 'ms') + duration.value((w - 1) * 7, 'd');
      }
      function boardOpen() {
        let start = boardStart();
        let days = board.split('-')[0] == 'daily' ? 1 : 7;
        return request.time > start - duration.value(15, 'h')
          && request.time < start + duration.value(days * 24 + 13, 'h');
      }

      // Arena rounds last 60 seconds. Each right answer earns 10 plus 2 per answer in the current streak (capped at +20),
      // so every gain is even and a round of n straight right answers (n >= 11) scores 30n - 110. There is no hard cap in
      // the game itself, so the cap is a generous human pace per league:
      //   explorer   2000 = 70 right in a row, one tap every 0.86 s (four big choices, simple counting and sums)
      //   challenger 1600 = 57 right in a row, one typed answer every 1.05 s (times tables, 2 to 4 digit answers)
      //   pro        1200 = 44 right in a row, one typed answer every 1.36 s (squares, roots, percents, logs, algebra)
      function maxScore() {
        return { 'explorer': 2000, 'challenger': 1600, 'pro': 1200 }[board.split('-')[board.split('-').size() - 1]];
      }
      function validEntry() {
        let d = request.resource.data;
        let w = d.name is string && d.name.size() <= 24 ? d.name.split(' ') : [];
        return d.keys().hasOnly(['name', 'avatar', 'score', 'ts', 'exp'])
          && d.keys().hasAll(['name', 'avatar', 'score', 'ts', 'exp'])
          && d.name is string && d.name.size() <= 24 && d.name.matches('^[A-Z][a-z]+ [A-Z][a-z]+ [1-9][0-9]$')
          && w.size() == 3
          && w[0] in ['Swift', 'Clever', 'Mighty', 'Cosmic', 'Brave', 'Lucky', 'Sunny', 'Zippy', 'Witty', 'Bold', 'Jolly', 'Turbo', 'Nimble', 'Sparky', 'Quiet', 'Rapid']
          && w[1] in ['Tiger', 'Falcon', 'Otter', 'Panda', 'Comet', 'Rocket', 'Koala', 'Dolphin', 'Phoenix', 'Lynx', 'Gecko', 'Orca', 'Yak', 'Robin', 'Badger', 'Narwhal']
          && d.avatar in ['coral', 'teal', 'sun', 'sky', 'plum']
          && d.score is int && d.score >= 10 && d.score <= maxScore() && d.score % 2 == 0
          && d.ts == request.time
          && d.exp is timestamp && d.exp > request.time + duration.value(1, 'd') && d.exp < request.time + duration.value(60, 'd');
      }

      // Reads: your own entry (checked before a submit) and top-20 lists. No browsing other players' entries one by one.
      allow get: if validBoard() && signedInAs();
      allow list: if validBoard() && request.auth != null && request.query.limit <= 20;

      allow create: if signedInAs() && validBoard() && boardOpen() && validEntry();
      // Only a higher score replaces an entry, and at most once per 50 seconds (a round plus its countdown is 62 s).
      allow update: if signedInAs() && validBoard() && boardOpen() && validEntry()
        && request.resource.data.score > resource.data.score
        && request.time > resource.data.ts + duration.value(50, 's');
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
